rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Fields only the Cloud Functions (Admin SDK) may set. The client
    // can never grant itself premium, credits, or a fake Stripe id.
    function touchesServerOnlyFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['premium','stripeCustomerId','stripeSubscriptionId','trialUsed','boostCredits']);
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && !touchesServerOnlyFields();
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likeCount','commentCount','boosted','boostedUntil'])
      );
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    match /checkins/{checkinId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /marketplace/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      // Seller can edit/update anything on their own listing. A buyer
      // may ONLY flip status+buyerConfirmed on a listing already marked
      // pending for them — they can't touch price, title, etc.
      allow update: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        (resource.data.buyerUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','buyerConfirmed']))
      );
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Shared counters for the 500-cap Founding Member / Diamond Member
    // badges. Anyone signed in can increment by exactly 1 (enforced
    // below), which is how the transaction-based cap stays exact even
    // under concurrent signups.
    match /meta/{metaId} {
      allow read: if true;
      allow create: if signedIn() && metaId in ['founding','diamond'] && request.resource.data.count == 1;
      allow update: if signedIn() && metaId in ['founding','diamond']
        && request.resource.data.count == resource.data.count + 1
        && resource.data.count < 500;
    }

    match /chats/{chatId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }
  }
}
